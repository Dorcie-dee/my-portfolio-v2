# Copy to .env.local and fill in. Only SANITY_API_READ_TOKEN (optional, below) is secret.
# Find the project ID at https://www.sanity.io/manage (your project's overview page).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: pin the Sanity API version (defaults to 2026-03-01).
# NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# Optional: override the site URL used in metadata (Vercel sets this automatically).
# NEXT_PUBLIC_SITE_URL=https://example.com

# Never add Sanity tokens with a NEXT_PUBLIC_ prefix.

# Optional, SERVER-ONLY: Sanity "Viewer" (read-only) token for previewing drafts in the
# Presentation tool at /manage. Never prefix it with NEXT_PUBLIC_. Without it, preview is off.
# SANITY_API_READ_TOKEN=
